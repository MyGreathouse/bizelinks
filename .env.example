# Copy this file to .env.local (and to .dev.vars for Cloudflare previews), then fill in.
# See docs/SUPABASE-SETUP.md for where each value comes from.
# NEVER put the Supabase *secret* key anywhere in this project.

# Your site's address. http://localhost:3000 while developing; https://bizelinks.com in production. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
